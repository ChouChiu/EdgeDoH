{
  "name": "edgedoh",
  "version": "0.0.0",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "imports": {
    "#dns": "./src/lib/dns/index.ts",
    "#filter": "./src/lib/filter/index.ts",
    "#contract": "./src/lib/contract/index.ts"
  },
  "bin": {
    "edgedoh": "./src/cli/main.ts"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "setup": "bun src/cli/setup.ts",
    "deploy": "bun run build && bun run db:migrate:remote && wrangler deploy",
    "secrets:push": "wrangler secret bulk .env.production",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "cli": "bun src/cli/main.ts",
    "test": "vitest run",
    "types": "wrangler types src/worker/worker-configuration.d.ts --strict-vars=false",
    "typecheck": "wrangler types src/worker/worker-configuration.d.ts --strict-vars=false --check && tsc -b"
  },
  "dependencies": {
    "@animate-ui/react": "^2.4.1",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/noto-serif": "^5.3.0",
    "@fontsource-variable/noto-serif-sc": "^5.3.1",
    "@fontsource-variable/noto-serif-tc": "^5.3.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.105.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.1",
    "hono": "^4.13.14",
    "jose": "^6.2.14",
    "lucide-react": "^1.66.0",
    "motion": "^14.9.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1",
    "recharts": "3.10.1",
    "shadcn": "^4.23.0",
    "sonner": "^2.0.8",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.66.0",
    "@cloudflare/vitest-plugin": "^1.4.11",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/bun": "^1.4.4",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "happy-dom": "^21.0.4",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "wrangler": "^4.156.0"
  },
  "cloudflare": {
    "bindings": {
      "ACCESS_TEAM_DOMAIN": {
        "description": "Zero Trust team domain protecting the dashboard, e.g. `myteam.cloudflareaccess.com`. Found under **Zero Trust > Settings > Team name and domain**"
      },
      "ACCESS_AUD": {
        "description": "Application Audience (AUD) tag of the Access application covering the dashboard hostname, under **Zero Trust > Access > Applications > Configure > Basic information**. See [the deployment guide](https://github.com/ChouChiu/EdgeDoH/blob/main/docs/deploy.md)"
      },
      "CF_ACCOUNT_ID": {
        "description": "Your Cloudflare account ID, shown on the account home page and in the dashboard URL"
      },
      "STATS_API_TOKEN": {
        "description": "API token with **Account > Account Analytics > Read**, used to read query statistics from Analytics Engine"
      },
      "DB": {
        "description": "Devices, filter lists and settings"
      },
      "RULES": {
        "description": "Compiled filter rule snapshots and list text"
      }
    }
  }
}
