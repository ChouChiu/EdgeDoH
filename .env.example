# Worker secrets: copy to .env.production for `bun run setup` / `bun run secrets:push`, and to .env for local
# development (add ACCESS_DEV_BYPASS=true there). The Deploy to Cloudflare button prompts for the same keys
# Never put ACCESS_DEV_BYPASS here: it is a plain var in wrangler.jsonc and a secret of the same name fails the deploy

# Cloudflare Access team domain protecting the dashboard and /api/*, e.g. myteam.cloudflareaccess.com
ACCESS_TEAM_DOMAIN=
# Application Audience (AUD) tag of that Access application
ACCESS_AUD=

# Analytics Engine SQL API: account ID and a token with Account Analytics Read
# Leave the token empty to disable the stats API; DNS keeps working
CF_ACCOUNT_ID=
STATS_API_TOKEN=
